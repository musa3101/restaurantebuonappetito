---
import '../styles/global.css';
import Preloader from '../components/Preloader.astro';
import { TRANSLATIONS } from '../data/translations';
import { AlertCookieNotice } from '../components/ui/AlertCookieNotice';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = "Buon Appetito | Cocina Mediterránea y Pizzería Artesanal",
  description = "Restaurante mediterráneo y pizzería artesanal en Port d'Andratx, Mallorca. Pizzas de masa fina y crujiente, pastas caseras, producto selecto italiano y pescados frescos frente al puerto.",
  image = "/assets/our-pizza.webp",
  type = "restaurant.restaurant"
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://buonappetito-andratx.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(image, siteUrl).toString();

// Estructuración Semántica Avanzada (Schema.org / JSON-LD) para Google Maps, Local Pack y Motores de IA (GEO)
const schemaJsonLd = {
  "@context": "https://schema.org",
  "@type": ["Restaurant", "ItalianRestaurant"],
  "@id": `${siteUrl}/#restaurant`,
  "name": "Buon Appetito",
  "alternateName": [
    "Restaurante Buon Appetito",
    "Buon Appetito Port d'Andratx",
    "Pizzería Buon Appetito Andratx"
  ],
  "description": description,
  "url": siteUrl,
  "logo": `${siteUrl}/favicon.svg`,
  "image": [
    ogImageUrl,
    `${siteUrl}/assets/our-pizza.webp`,
    `${siteUrl}/assets/gallery/frame_18s.jpg`
  ],
  "telephone": "+34632446064",
  "email": "buonappetitoandratx@gmail.com",
  "priceRange": "€€",
  "currenciesAccepted": "EUR",
  "paymentAccepted": "Cash, Credit Card, Debit Card, Apple Pay, Google Pay, Contactless",
  "servesCuisine": [
    "Italian",
    "Mediterranean",
    "Pizza artesanal",
    "Pasta fresca",
    "Pescados y Mariscos"
  ],
  "hasMenu": `${siteUrl}/carta`,
  "acceptsReservations": "True",
  "potentialAction": {
    "@type": "ReserveAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://www.bavoli.com/book/buon-appetito",
      "inLanguage": ["es", "en", "de", "it"],
      "actionPlatform": [
        "http://schema.org/DesktopWebPlatform",
        "http://schema.org/MobileWebPlatform"
      ]
    },
    "result": {
      "@type": "FoodEstablishmentReservation",
      "name": "Reserva de mesa en Buon Appetito"
    }
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Avenida Mateo Bosch, 24",
    "addressLocality": "Port d'Andratx",
    "addressRegion": "Illes Balears",
    "postalCode": "07157",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 39.5443444,
    "longitude": 2.3882905
  },
  "hasMap": "https://maps.app.goo.gl/nC1F69YNFf4TghwD6",
  "sameAs": [
    "https://maps.app.goo.gl/nC1F69YNFf4TghwD6",
    "https://www.tripadvisor.es/Restaurant_Review-g616239-d24183908-Reviews-Grand_Pasta-Port_d_Andratx_Majorca_Balearic_Islands.html"
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ],
      "opens": "11:30",
      "closes": "23:30"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "148",
    "bestRating": "5",
    "worstRating": "1"
  },
  "areaServed": [
    { "@type": "City", "name": "Port d'Andratx" },
    { "@type": "City", "name": "Andratx" },
    { "@type": "AdministrativeArea", "name": "Mallorca" }
  ],
  "amenityFeature": [
    { "@type": "LocationFeatureSpecification", "name": "Terraza frente al mar y puerto deportivo", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Pizzas artesanales de masa fina y crujiente", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Pastas caseras y especialidades mediterráneas", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Salón interior climatizado", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Opciones vegetarianas", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Bodega selecta de vinos italianos y de Mallorca", "value": true }
  ]
};
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth overflow-x-hidden bg-[#183321]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <!-- Barra superior de Safari / navegador en verde oliva corporativo (estilo Arko) -->
    <meta name="theme-color" content="#183321" />
    <meta name="color-scheme" content="dark light" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph (WhatsApp, Telegram, Facebook, iMessage) -->
    <meta property="og:site_name" content="Buon Appetito · Port d'Andratx" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="786" />
    <meta property="og:image:alt" content="Buon Appetito - Pizzería artesanal y cocina mediterránea en Port d'Andratx" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta property="og:locale:alternate" content="de_DE" />
    <meta property="og:locale:alternate" content="it_IT" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- SEO Local y Geoposicionamiento (Google Maps, Bing, Apple Maps, Motores GEO) -->
    <meta name="geo.region" content="ES-IB" />
    <meta name="geo.placename" content="Port d'Andratx, Illes Balears" />
    <meta name="geo.position" content="39.544344;2.388291" />
    <meta name="ICBM" content="39.544344, 2.388291" />

    <!-- Datos Estructurados JSON-LD Schema.org para Motores de Búsqueda e IA (Perplexity, ChatGPT, Gemini) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaJsonLd)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- Fontshare Fonts: Boska, Satoshi, General Sans, Cabinet Grotesk & Clash Display (Tipografía de Alta Gama) -->
    <link href="https://api.fontshare.com/v2/css?f[]=boska@300,400,500,600,700,italic&f[]=satoshi@300,400,500,600,700&f[]=general-sans@400,500,600,700&f[]=cabinet-grotesk@500,700,800&f[]=clash-display@500,600,700&display=swap" rel="stylesheet" />

    <!-- Google Fonts: Cormorant Garamond, Plus Jakarta Sans, Outfit, Playfair Display & Questrial -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Questrial&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- Control de Scroll Inteligente: Permite volver a la sección exacta y forzar inicio al entrar de cero o tocar logo -->
    <script is:inline>
      (function() {
        try {
          if ('scrollRestoration' in history) {
            history.scrollRestoration = 'auto';
          }

          const navEntries = performance.getEntriesByType('navigation');
          const isBackForward = navEntries.length > 0 && navEntries[0].type === 'back_forward';

          function scrollToSection(hash) {
            if (!hash) return;
            const target = document.querySelector(hash);
            if (target) {
              const headerOffset = 80;
              const elementPosition = target.getBoundingClientRect().top;
              const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
              window.scrollTo({
                top: Math.max(0, offsetPosition),
                behavior: 'smooth'
              });
            }
          }

          if (window.location.hash && window.location.hash !== '#inicio') {
            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', function() {
                setTimeout(function() { scrollToSection(window.location.hash); }, 80);
              });
            } else {
              setTimeout(function() { scrollToSection(window.location.hash); }, 80);
            }
          } else if (!isBackForward) {
            // Entrada limpia o recarga inicial: comenzar en el Hero
            window.scrollTo(0, 0);
            if (window.location.hash === '#inicio') {
              history.replaceState(null, '', window.location.pathname);
            }
          }

          window.addEventListener('buon:preloader-unlocked', function() {
            if (window.location.hash && window.location.hash !== '#inicio') {
              setTimeout(function() { scrollToSection(window.location.hash); }, 60);
            }
          });

          // Clic en el logo oficial (Header o Footer): siempre desplaza al inicio suavemente
          document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('[data-logo-home]').forEach(function(el) {
              el.addEventListener('click', function(e) {
                if (window.location.pathname === '/' || window.location.pathname === '') {
                  e.preventDefault();
                  window.scrollTo({ top: 0, behavior: 'smooth' });
                  if (window.location.hash) {
                    history.replaceState(null, '', window.location.pathname);
                  }
                }
              });
            });
          });
        } catch (e) {}
      })();
    </script>

    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "z6ux9thsuf");
    </script>
  </head>
  <body class="bg-[#FBF9F5] text-[#1B1C1A] font-sans antialiased selection:bg-[#9E4221] selection:text-white relative overflow-x-hidden min-h-screen">
    <Preloader />
    <slot />
    <AlertCookieNotice client:idle />

    <!-- Runtime Oficial de Traducción (i18nstack) -->
    <script is:inline define:vars={{ TRANSLATIONS }}>
      window.BUON_TRANSLATIONS = TRANSLATIONS;

      function setBuonLanguage(lang) {
        if (!lang || !window.BUON_TRANSLATIONS || !window.BUON_TRANSLATIONS[lang]) return;

        try {
          localStorage.setItem('buon_appetito_lang', lang);
          localStorage.setItem('preferred_language', lang);
        } catch (e) {}

        document.documentElement.lang = lang;
        const dict = window.BUON_TRANSLATIONS[lang];

        // 1. Textos data-i18n
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (key && dict[key] !== undefined) {
            el.textContent = dict[key];
          }
        });

        // 2. HTML data-i18n-html
        document.querySelectorAll('[data-i18n-html]').forEach((el) => {
          const key = el.getAttribute('data-i18n-html');
          if (key && dict[key] !== undefined) {
            el.innerHTML = dict[key];
          }
        });

        // 3. Bloques completos por idioma (data-lang-block para páginas legales y contenido rico)
        document.querySelectorAll('[data-lang-block]').forEach((el) => {
          const blockLang = el.getAttribute('data-lang-block');
          if (blockLang === lang) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });

        // 4. Botones de Selector de Idioma (Desktop Header, Mobile Drawer & Footer)
        document.querySelectorAll('[data-lang-btn]').forEach((btn) => {
          const btnLang = btn.getAttribute('data-lang-btn');
          const isActive = btnLang === lang;
          const isLightBg = !!btn.closest('footer') || !!btn.closest('.lang-selector-light');
          const isMobileMenu = !!btn.closest('#mobile-menu-drawer');
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          
          if (isActive) {
            btn.classList.add('font-bold', 'opacity-100');
            btn.classList.remove('opacity-60', 'font-normal');
            if (isMobileMenu) {
              btn.classList.add('text-[#C45E3B]');
              btn.classList.remove('text-white', 'text-[#183321]');
            } else if (isLightBg) {
              btn.classList.add('text-[#183321]');
              btn.classList.remove('text-white', 'text-[#C45E3B]');
            } else {
              btn.classList.add('text-white');
              btn.classList.remove('text-[#183321]', 'text-[#C45E3B]');
            }
          } else {
            btn.classList.remove('font-bold', 'opacity-100', 'text-white', 'text-[#C45E3B]');
            btn.classList.add('opacity-60', 'font-normal');
            if (isLightBg) {
              btn.classList.remove('text-[#183321]');
            }
          }
        });

        // 5. Notificar a componentes cliente (HeroActions, carrusel polaroid, menús dinámicos)
        window.dispatchEvent(new CustomEvent('buon:languageChange', { detail: { lang } }));
      }

      window.setBuonLanguage = setBuonLanguage;

      function initI18n() {
        let savedLang = 'es';
        try {
          savedLang = localStorage.getItem('buon_appetito_lang') || localStorage.getItem('preferred_language') || 'es';
        } catch (e) {}
        setBuonLanguage(savedLang);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initI18n);
      } else {
        initI18n();
      }
      document.addEventListener('astro:page-load', initI18n);
    </script>
  </body>
</html>
