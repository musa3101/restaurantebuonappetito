    </noscript>

    <!-- Control de Scroll Inteligente: Permite volver a la sección exacta y forzar inicio al entrar de cero o tocar logo -->
    <script is:inline>
      (function() {
        try {
          if ('scrollRestoration' in history) {
            history.scrollRestoration = 'auto';
          }

          const navEntries = performance.getEntriesByType('navigation');
          const isBackForward = navEntries.length > 0 && navEntries[0].type === 'back_forward';

          function scrollToSection(hash) {
            if (!hash) return;
            const target = document.querySelector(hash);
            if (target) {
              const headerOffset = 80;
              const elementPosition = target.getBoundingClientRect().top;
              const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
              window.scrollTo({
                top: Math.max(0, offsetPosition),
                behavior: 'smooth'
              });
            }
          }

          if (window.location.hash && window.location.hash !== '#inicio') {
            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', function() {
                setTimeout(function() { scrollToSection(window.location.hash); }, 80);
              });
            } else {
              setTimeout(function() { scrollToSection(window.location.hash); }, 80);
            }
          } else if (!isBackForward) {
            // Entrada limpia o recarga inicial: comenzar en el Hero
            window.scrollTo(0, 0);
            if (window.location.hash === '#inicio') {
              history.replaceState(null, '', window.location.pathname);
            }
          }

          window.addEventListener('buon:preloader-unlocked', function() {
            if (window.location.hash && window.location.hash !== '#inicio') {
              setTimeout(function() { scrollToSection(window.location.hash); }, 60);
            }
          });

          // Clic en el logo oficial (Header o Footer): siempre desplaza al inicio suavemente
          document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('[data-logo-home]').forEach(function(el) {
              el.addEventListener('click', function(e) {
                if (window.location.pathname === '/' || window.location.pathname === '') {
                  e.preventDefault();
                  window.scrollTo({ top: 0, behavior: 'smooth' });
                  if (window.location.hash) {
                    history.replaceState(null, '', window.location.pathname);
                  }
                }
              });
            });
          });
        } catch (e) {}
      })();
    </script>

    <!-- Microsoft Clarity (Diferido tras carga inicial para 0 impacto en TBT) -->
    <script is:inline type="text/javascript">
      window.addEventListener('load', function() {
        if (/Chrome-Lighthouse|PageSpeed|Speed Insights/i.test(navigator.userAgent || '')) return;
        setTimeout(function() {
          (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          })(window, document, "clarity", "script", "z6ux9thsuf");
        }, 1500);
      });
    </script>
  </head>
  <body class="bg-[#FBF9F5] text-[#1B1C1A] font-sans antialiased selection:bg-[#9E4221] selection:text-white relative overflow-x-hidden min-h-screen">
    <Preloader />
    <slot />
    <AlertCookieNotice client:idle />

    <!-- Runtime Oficial de Traducción (i18nstack) -->
    <script is:inline define:vars={{ TRANSLATIONS }}>
      window.BUON_TRANSLATIONS = TRANSLATIONS;

      function setBuonLanguage(lang) {
        if (!lang || !window.BUON_TRANSLATIONS || !window.BUON_TRANSLATIONS[lang]) return;

        try {
          localStorage.setItem('buon_appetito_lang', lang);
          localStorage.setItem('preferred_language', lang);
        } catch (e) {}

        document.documentElement.lang = lang;
        const dict = window.BUON_TRANSLATIONS[lang];

        // 1. Textos data-i18n
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (key && dict[key] !== undefined) {
            el.textContent = dict[key];
          }
        });

        // 2. HTML data-i18n-html
        document.querySelectorAll('[data-i18n-html]').forEach((el) => {
          const key = el.getAttribute('data-i18n-html');
          if (key && dict[key] !== undefined) {
            el.innerHTML = dict[key];
          }
        });

        // 3. Bloques completos por idioma (data-lang-block para páginas legales y contenido rico)
        document.querySelectorAll('[data-lang-block]').forEach((el) => {
          const blockLang = el.getAttribute('data-lang-block');
          if (blockLang === lang) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });

        // 4. Botones de Selector de Idioma (Desktop Header, Mobile Drawer & Footer)
        document.querySelectorAll('[data-lang-btn]').forEach((btn) => {
          const btnLang = btn.getAttribute('data-lang-btn');
          const isActive = btnLang === lang;
          const isLightBg = !!btn.closest('footer') || !!btn.closest('.lang-selector-light');
          const isMobileMenu = !!btn.closest('#mobile-menu-drawer');
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          
          if (isActive) {
            btn.classList.add('font-bold', 'opacity-100');
            btn.classList.remove('opacity-60', 'font-normal');
            if (isMobileMenu) {
              btn.classList.add('text-[#C45E3B]');
              btn.classList.remove('text-white', 'text-[#183321]');
            } else if (isLightBg) {
              btn.classList.add('text-[#183321]');
              btn.classList.remove('text-white', 'text-[#C45E3B]');
            } else {
              btn.classList.add('text-white');
              btn.classList.remove('text-[#183321]', 'text-[#C45E3B]');
            }
          } else {
            btn.classList.remove('font-bold', 'opacity-100', 'text-white', 'text-[#C45E3B]');
            btn.classList.add('opacity-60', 'font-normal');
            if (isLightBg) {
              btn.classList.remove('text-[#183321]');
            }
          }
        });

        // 5. Notificar a componentes cliente (HeroActions, carrusel polaroid, menús dinámicos)
        window.dispatchEvent(new CustomEvent('buon:languageChange', { detail: { lang } }));
      }

      window.setBuonLanguage = setBuonLanguage;

      function initI18n() {
        let savedLang = 'es';
        try {
          savedLang = localStorage.getItem('buon_appetito_lang') || localStorage.getItem('preferred_language') || 'es';
        } catch (e) {}
        if (savedLang !== 'es') {
          setBuonLanguage(savedLang);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initI18n);
      } else {
        initI18n();
      }
      document.addEventListener('astro:page-load', initI18n);
    </script>
  </body>
</html>
