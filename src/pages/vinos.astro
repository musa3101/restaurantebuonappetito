---
// Carta de Vinos & Bodega Oficial · Buon Appetito (Port d'Andratx)
import PizzaMenuLoader from '../components/PizzaMenuLoader.astro';
import BuonAppetitoWordmark from '../components/ui/BuonAppetitoWordmark';
const title = "Carta de Vinos & Bodega | Buon Appetito • Port d'Andratx";
const description = "Carta oficial de vinos y bodega de Buon Appetito en Port d'Andratx. Vinos de Mallorca, grandes denominaciones de España e Italia, y Champagnes seleccionados.";
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth overflow-x-hidden">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="shortcut icon" href="/favicon.ico" />

  <!-- Google Fonts: Cormorant Garamond (Elegancia Vinícola) & Plus Jakarta Sans (Claridad Moderna) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <meta name="theme-color" content="#183321" />

  <!-- Control de Scroll Limpio y Restauración Nativa -->
  <script is:inline>
    try {
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'auto';
      }
    } catch (e) {}
  </script>

  <!-- Microsoft Clarity -->
  <script is:inline type="text/javascript">
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "z6ux9thsuf");
  </script>
</head>
<body class="wine-body">

  <!-- Loader Oficial de Buon Appetito -->
  <PizzaMenuLoader />

  <!-- ======================================================== -->
  <!-- 1. TOP HEADER: VERDE CIPRÉS + LOGO + SELECTOR ES/EN      -->
  <!-- ======================================================== -->
  <header class="site-header">
    <div class="container header-container">
      
      <!-- Logotipo Oficial -->
      <a href="/" class="brand-logo-link" title="Buon Appetito Port d'Andratx">
        <img 
          src="/assets/logos/logo-buon-appetito-color-dark.png" 
          alt="Buon Appetito Port d'Andratx" 
          class="brand-logo"
        />
      </a>

      <!-- Acciones de Cabecera: Selector Exclusivo ES / EN + Volver -->
      <div class="header-actions">
        
        <!-- Selector Bilingüe ES / EN (Sin Alemán) -->
        <div class="lang-switch-toggle" id="lang-switch" role="group" aria-label="Seleccionar idioma">
          <button type="button" class="lang-switch-btn active" data-lang="es" aria-pressed="true">ES</button>
          <span class="lang-switch-divider" aria-hidden="true">|</span>
          <button type="button" class="lang-switch-btn" data-lang="en" aria-pressed="false">EN</button>
        </div>

        <!-- Botón Volver Atrás en terracota -->
        <button type="button" id="btn-back" class="btn-back" aria-label="Volver a la página principal">
          <svg class="back-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span id="txt-back">Volver</span>
        </button>

      </div>

    </div>
  </header>

  <!-- ======================================================== -->
  <!-- 2. HERO EDITORIAL DE BODEGA                              -->
  <!-- ======================================================== -->
  <section class="wine-hero" id="inicio">
    <div class="container hero-container">
      <span class="hero-eyebrow" id="hero-eyebrow">BUON APPETITO · PORT D'ANDRATX</span>
      <h1 class="hero-title" id="hero-title">Carta de Vinos</h1>
      <p class="hero-subtitle" id="hero-subtitle">BODEGA SELECCIONADA · MALLORCA, ITALIA & FRANCIA</p>
      <div class="hero-divider" aria-hidden="true">
        <span class="line"></span>
        <svg class="wine-glass-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d="M8 22h8"/>
          <path d="M7 10h10"/>
          <path d="M12 15v7"/>
          <path d="M12 15a5 5 0 0 0 5-5c0-2-.5-4-2-8H9c-1.5 4-2 6-2 8a5 5 0 0 0 5 5Z"/>
        </svg>
        <span class="line"></span>
      </div>
    </div>
  </section>

  <!-- ======================================================== -->
  <!-- 3. BARRA DE NAVEGACIÓN STICKY DE CATEGORÍAS (SIN EMOJIS) -->
  <!-- ======================================================== -->
  <div class="category-nav-bar">
    <div class="container nav-container">
      <nav class="category-nav-track" id="category-nav" aria-label="Categorías de vinos">
        <button type="button" class="cat-nav-link active" data-cat="casa">
          <span class="cat-text" data-cat-text="casa">Vinos de la Casa</span>
        </button>
        <button type="button" class="cat-nav-link" data-cat="mallorca">
          <span class="cat-text" data-cat-text="mallorca">Vinos de Mallorca</span>
        </button>
        <button type="button" class="cat-nav-link" data-cat="otros">
          <span class="cat-text" data-cat-text="otros">Otros Vinos</span>
        </button>
        <button type="button" class="cat-nav-link" data-cat="espumosos">
          <span class="cat-text" data-cat-text="espumosos">Vinos Espumosos</span>
        </button>
      </nav>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- 4. CONTENIDO PRINCIPAL: CARTA DE VINOS EDITORIAL LIMPIA   -->
  <!-- ======================================================== -->
  <main class="container main-content">
    <div id="wine-content" class="wine-content-area">
      <!-- Inyectado dinámicamente vía script -->
    </div>
  </main>

  <!-- ======================================================== -->
  <!-- 5. FOOTER SAGE MIST (VERDE SALVIA REFINADO)              -->
  <!-- ======================================================== -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-card">
        
        <!-- Precios e Información -->
        <p id="tax-note" class="tax-note">
          Precios con IVA incluido.
        </p>
        <p id="allergen-note" class="allergen-note">
          Nuestra bodega cuenta con referencias seleccionadas con esmero. Si desea una recomendación especial o conocer las añadas disponibles, no dude en consultar a nuestro personal.
        </p>

        <!-- Botones de Acción Rápida -->
        <div class="footer-actions">
          <button type="button" id="btn-back-bottom" class="btn-footer-back">
            <svg class="back-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            <span id="txt-back-bottom">Volver a la Página Principal</span>
          </button>
          
          <a href="/#reservas" class="btn-footer-reserve" id="footer-reservar-link">
            Reservar mesa
          </a>
        </div>

        <!-- Enlaces Legales -->
        <div class="footer-legal">
          <a href="/aviso-legal" class="legal-link" id="legal-aviso">Aviso Legal</a>
          <span class="legal-sep" aria-hidden="true">·</span>
          <a href="/privacidad" class="legal-link" id="legal-privacidad">Privacidad</a>
          <span class="legal-sep" aria-hidden="true">·</span>
          <a href="/cookies" class="legal-link" id="legal-cookies">Cookies</a>
        </div>

      </div>
    </div>

    <!-- Franja final de marca -->
    <div class="footer-wordmark-wrap">
      <BuonAppetitoWordmark client:visible />
    </div>
  </footer>

  <!-- ======================================================== -->
  <!-- SCRIPTS: DATOS, BILINGÜE ES/EN & NAVEGACIÓN              -->
  <!-- ======================================================== -->
  <script is:inline>
    // Escape XSS
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

    const UI_TEXT = {
      es: {
        eyebrow: "BUON APPETITO · PORT D'ANDRATX",
        heroTitle: "Carta de Vinos",
        heroSubtitle: "BODEGA SELECCIONADA · MALLORCA, ITALIA & FRANCIA",
        btnBack: "Volver",
        btnBackBottom: "Volver a la Página Principal",
        reserveTable: "Reservar mesa",
        taxIncluded: "Precios con IVA incluido.",
        serviceNote: "Nuestra bodega cuenta con referencias seleccionadas con esmero. Si desea una recomendación especial o conocer las añadas disponibles, no dude en consultar a nuestro personal.",
        cats: {
          casa: "Vinos de la Casa",
          mallorca: "Vinos de Mallorca",
          otros: "Otros Vinos",
          espumosos: "Vinos Espumosos"
        },
        subcats: {
          blanco: "Blanco",
          rosado: "Rosado",
          tinto: "Tinto",
          espumoso: "Espumoso"
        },
        finaleTitle: "Buon Appetito · Bodega",
        finaleSub: "PASIÓN POR EL VINO Y LA TRADICIÓN MEDITERRÁNEA",
        legalAviso: "Aviso Legal",
        legalPrivacidad: "Privacidad",
        legalCookies: "Cookies"
      },
      en: {
        eyebrow: "BUON APPETITO · PORT D'ANDRATX",
        heroTitle: "Wine List",
        heroSubtitle: "SELECTED CELLAR · MALLORCA, ITALY & FRANCE",
        btnBack: "Back",
        btnBackBottom: "Back to Home Page",
        reserveTable: "Book a table",
        taxIncluded: "All prices include VAT.",
        serviceNote: "Our cellar features carefully curated wines. Should you wish for a special recommendation or current vintages, please ask our sommelier team.",
        cats: {
          casa: "House Wines",
          mallorca: "Mallorca Wines",
          otros: "More Wines",
          espumosos: "Sparkling Wines"
        },
        subcats: {
          blanco: "White",
          rosado: "Rosé",
          tinto: "Red",
          espumoso: "Sparkling"
        },
        finaleTitle: "Buon Appetito · Cellar",
        finaleSub: "PASSION FOR WINE & MEDITERRANEAN TRADITION",
        legalAviso: "Legal Notice",
        legalPrivacidad: "Privacy Policy",
        legalCookies: "Cookies"
      }
    };

    let currentLang = 'es';
    let vinosData = null;

    async function initVinosPage() {
      // 1. Cargar datos de la carta oficial
      try {
        const res = await fetch('/data/vinos.json');
        if (res.ok) {
          vinosData = await res.json();
        }
      } catch (e) {
        console.warn('Error al cargar /data/vinos.json:', e);
      }

      // 2. Control de Botón Volver (Vuelve a #menu)
      const handleBack = () => {
        try {
          const lastSec = sessionStorage.getItem('buon_last_section') || '#menu';
          window.location.href = '/' + lastSec;
        } catch (e) {
          window.location.href = '/#menu';
        }
      };

      const btnBack = document.getElementById('btn-back');
      if (btnBack) btnBack.addEventListener('click', handleBack);

      const btnBackBottom = document.getElementById('btn-back-bottom');
      if (btnBackBottom) btnBackBottom.addEventListener('click', handleBack);

      // 3. Selector de Idioma Exclusivo ES / EN
      const switchButtons = document.querySelectorAll('.lang-switch-btn');
      switchButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const lang = btn.getAttribute('data-lang');
          if (lang === currentLang) return;
          currentLang = lang;

          switchButtons.forEach(b => {
            const isActive = b.getAttribute('data-lang') === currentLang;
            b.classList.toggle('active', isActive);
            b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          });

          updateUIText();
          renderWineList();
        });
      });

      // 4. Navegación por categorías con scroll suave
      setupCategoryNav();

      // 5. Renderizado Inicial
      updateUIText();
      renderWineList();
    }

    function setupCategoryNav() {
      const navLinks = document.querySelectorAll('.cat-nav-link');
      navLinks.forEach(btn => {
        btn.addEventListener('click', () => {
          navLinks.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          const catId = btn.getAttribute('data-cat');
          const target = document.getElementById(`sec-${catId}`);
          if (target) {
            const headerOffset = 120;
            const elementPosition = target.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });
          }
        });
      });

      // Scroll Spy para actualizar categoría activa al hacer scroll
      window.addEventListener('scroll', () => {
        const sections = document.querySelectorAll('.wine-category-section');
        const scrollPos = window.pageYOffset + 140;

        sections.forEach(sec => {
          const top = sec.offsetTop;
          const height = sec.offsetHeight;
          const id = sec.id.replace('sec-', '');

          if (scrollPos >= top && scrollPos < top + height) {
            navLinks.forEach(link => {
              if (link.getAttribute('data-cat') === id) {
                link.classList.add('active');
              } else {
                link.classList.remove('active');
              }
            });
          }
        });
      }, { passive: true });
    }

    function updateUIText() {
      const t = UI_TEXT[currentLang];
      if (!t) return;

      const eyebrowEl = document.getElementById('hero-eyebrow');
      const titleEl = document.getElementById('hero-title');
      const subTitleEl = document.getElementById('hero-subtitle');
      const txtBackEl = document.getElementById('txt-back');
      const txtBackBottomEl = document.getElementById('txt-back-bottom');
      const taxNoteEl = document.getElementById('tax-note');
      const allergenNoteEl = document.getElementById('allergen-note');
      const linkReservarEl = document.getElementById('footer-reservar-link');
      const legalAvisoEl = document.getElementById('legal-aviso');
      const legalPrivacidadEl = document.getElementById('legal-privacidad');
      const legalCookiesEl = document.getElementById('legal-cookies');

      if (eyebrowEl) eyebrowEl.textContent = t.eyebrow;
      if (titleEl) titleEl.textContent = t.heroTitle;
      if (subTitleEl) subTitleEl.textContent = t.heroSubtitle;
      if (txtBackEl) txtBackEl.textContent = t.btnBack;
      if (txtBackBottomEl) txtBackBottomEl.textContent = t.btnBackBottom;
      if (taxNoteEl) taxNoteEl.textContent = t.taxIncluded;
      if (allergenNoteEl) allergenNoteEl.textContent = t.serviceNote;
      if (linkReservarEl) linkReservarEl.textContent = t.reserveTable;
      if (legalAvisoEl) legalAvisoEl.textContent = t.legalAviso;
      if (legalPrivacidadEl) legalPrivacidadEl.textContent = t.legalPrivacidad;
      if (legalCookiesEl) legalCookiesEl.textContent = t.legalCookies;

      // Actualizar etiquetas en la barra de navegación (texto puro, sin emojis)
      document.querySelectorAll('[data-cat-text]').forEach(el => {
        const catKey = el.getAttribute('data-cat-text');
        if (t.cats[catKey]) {
          el.textContent = t.cats[catKey];
        }
      });
    }

    function renderWineList() {
      const container = document.getElementById('wine-content');
      if (!container || !vinosData || !vinosData.sections) return;

      const t = UI_TEXT[currentLang];
      let html = '';

      vinosData.sections.forEach(sec => {
        const secTitle = sec.title[currentLang] || sec.title.es;
        const secSubtitle = sec.subtitle ? (sec.subtitle[currentLang] || sec.subtitle.es) : '';

        html += `
          <section class="wine-category-section" id="sec-${esc(sec.id)}">
            <div class="wine-category-header">
              <div class="wine-category-title-wrap">
                <h2 class="wine-category-heading">${esc(secTitle)}</h2>
                ${secSubtitle ? `<p class="wine-category-sub">${esc(secSubtitle)}</p>` : ''}
              </div>
              <div class="wine-header-rule" aria-hidden="true"></div>
            </div>
        `;

        // Caso 1: Sección con subsecciones (Blanco, Rosado, Tinto)
        if (sec.subsections && sec.subsections.length > 0) {
          sec.subsections.forEach(sub => {
            const subTitle = sub.title[currentLang] || sub.title.es;

            html += `
              <div class="wine-subsection">
                <div class="wine-sub-header">
                  <h3 class="wine-sub-title">${esc(subTitle.toUpperCase())}</h3>
                  <span class="wine-sub-line"></span>
                </div>

                <div class="wine-editorial-list">
                  ${sub.items.map(item => renderWineRow(item)).join('')}
                </div>
              </div>
            `;
          });
        } 
        // Caso 2: Sección con items directos (Vinos de la Casa, Espumosos)
        else if (sec.items && sec.items.length > 0) {
          html += `
            <div class="wine-editorial-list">
              ${sec.items.map(item => renderWineRow(item)).join('')}
            </div>
          `;
        }

        html += `</section>`;
      });

      // Grabado editorial elegante de cierre
      html += `
        <div class="menu-finale-engraving" aria-hidden="true">
          <img 
            src="/assets/decorations/grabado_vino_panoramico.png" 
            alt="Bodega Buon Appetito"
            class="finale-wine-expanded-img" 
            loading="lazy"
          />
          <div class="finale-caption">
            <span class="finale-title">${esc(t.finaleTitle)}</span>
            <span class="finale-sub">${esc(t.finaleSub)}</span>
          </div>
          <div class="finale-divider">
            <span class="divider-line"></span>
            <span class="divider-diamond">◆</span>
            <span class="divider-line"></span>
          </div>
        </div>
      `;

      container.innerHTML = html;
    }

    function renderWineRow(item) {
      const name = typeof item.name === 'object' ? (item.name[currentLang] || item.name.es) : item.name;
      const detail = typeof item.detail === 'object' ? (item.detail[currentLang] || item.detail.es) : item.detail;
      const formattedPrice = Number(item.price).toFixed(0);

      return `
        <article class="wine-item-row">
          <div class="wine-item-top">
            <h4 class="wine-item-name">${esc(name)}</h4>
            <span class="wine-item-dots" aria-hidden="true"></span>
            <span class="wine-item-price">${formattedPrice} €</span>
          </div>
          ${detail ? `<p class="wine-item-desc">${esc(detail)}</p>` : ''}
        </article>
      `;
    }

    document.addEventListener('DOMContentLoaded', initVinosPage);
  </script>

</body>
</html>

<style is:global>
/* ========================================================
   ESTILOS DE CARTA DE VINOS · BUON APPETITO (ALTA ENOLOGÍA)
   ======================================================== */
:root {
  --wine-bg: #FAF8F5;
  --wine-surface: #FFFFFF;
  
  --color-forest: #183321;
  --color-forest-deep: #0E2015;
  --color-terracotta: #9E4221;
  --color-terracotta-hover: #7E3114;
  --color-gold: #C5A880;
  --color-gold-deep: #A78453;

  --color-text-main: #191C19;
  --color-text-body: #5A655C;
  --color-text-muted: #7A867E;

  --border-subtle: #E8ECE6;
  --color-dots: rgba(24, 51, 33, 0.22);

  --footer-bg: linear-gradient(180deg, #E2EAE3 0%, #D8E3DA 50%, #CDDCD0 100%);
  --footer-border: #B8CEBC;
  --footer-text: #183321;
  --footer-muted: #2C4132;

  /* Tipografías: Cormorant Garamond para enología pura */
  --font-wine-serif: "Cormorant Garamond", Georgia, "Times New Roman", serif;
  --font-wine-sans: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body.wine-body {
  background-color: var(--wine-bg);
  color: var(--color-text-main);
  font-family: var(--font-wine-sans);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

.container {
  width: 100%;
  max-width: 840px;
  margin: 0 auto;
  padding: 0 20px;
}

/* 1. Top Header */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--color-forest);
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
}

.header-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64px;
}

.brand-logo-link {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
}

.brand-logo {
  height: 38px;
  width: auto;
  object-fit: contain;
  filter: drop-shadow(0 1px 2px rgba(0,0,0,0.2));
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

/* Selector Exclusivo ES / EN */
.lang-switch-toggle {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.24);
  border-radius: 9999px;
  padding: 3px 8px;
  gap: 6px;
}

.lang-switch-btn {
  background: none;
  border: none;
  color: rgba(255, 255, 255, 0.65);
  font-family: var(--font-wine-sans);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  padding: 2px 6px;
  cursor: pointer;
  border-radius: 999px;
  transition: all 0.2s ease;
}

.lang-switch-btn.active {
  color: #183321;
  background: #FFFFFF;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
}

.lang-switch-btn:hover:not(.active) {
  color: #FFFFFF;
}

.lang-switch-divider {
  color: rgba(255, 255, 255, 0.25);
  font-size: 0.75rem;
}

/* Botón Volver */
.btn-back {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--color-terracotta);
  color: #FFFFFF;
  border: none;
  border-radius: 9999px;
  padding: 7px 18px;
  font-family: var(--font-wine-sans);
  font-size: 0.85rem;
  font-weight: 700;
  cursor: pointer;
  text-decoration: none;
  box-shadow: 0 2px 10px rgba(158, 66, 33, 0.35);
  transition: all 0.2s ease;
}

.btn-back:hover {
  background: var(--color-terracotta-hover);
  transform: translateY(-1px);
}

/* 2. Hero Editorial Vinícola */
.wine-hero {
