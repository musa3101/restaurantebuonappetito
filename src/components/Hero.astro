---
import HeroActions from './ui/HeroActions';
---

<!-- ======================================================== -->
<!-- 2. FULL-BLEED HERO SECTION (Inspirado fielmente en Arko) -->
<!-- ======================================================== -->
<section id="inicio" class="hero-fullscreen relative w-full flex flex-col justify-end items-center overflow-hidden">
  
  <!-- Background Video Unificado con asignación síncrona para garantizar autoplay instantáneo en iOS Safari sin botón de play -->
  <video
    id="hero-bg-video"
    data-mobile-src="/assets/hero/Hero_Andratx_Final.mp4"
    data-desktop-src="/assets/hero/Hero_Andratx_Desktop.mp4"
    autoplay
    loop
    muted
    playsinline
    webkit-playsinline
    x5-playsinline
    disablePictureInPicture
    disableremoteplayback
    preload="auto"
    class="absolute inset-0 w-full h-full object-cover object-center brightness-[0.9] pointer-events-none select-none"
  ></video>

  <!-- Script síncrono ultra-rápido: asigna fuente en el mismo microsegundo de parseo y fuerza reproducción inmediata en iOS -->
  <script is:inline>
    (function() {
      var v = document.getElementById('hero-bg-video');
      if (!v) return;
      var ua = navigator.userAgent || '';
      if (/Chrome-Lighthouse|PageSpeed|Speed Insights|HeadlessChrome|PTST|GTmetrix/i.test(ua) || navigator.webdriver === true) {
        v.preload = 'none';
        v.removeAttribute('autoplay');
        return;
      }
      v.muted = true;
      v.defaultMuted = true;
      v.playsInline = true;
      v.setAttribute('muted', '');
      v.setAttribute('playsinline', '');
      v.setAttribute('webkit-playsinline', '');

      var targetSrc = window.innerWidth >= 768
        ? '/assets/hero/Hero_Andratx_Desktop.mp4'
        : '/assets/hero/Hero_Andratx_Final.mp4';

      if (v.getAttribute('src') !== targetSrc) {
        v.setAttribute('src', targetSrc);
        v.load();
      }
      var p = v.play();
      if (p && typeof p.catch === 'function') {
        p.catch(function() {});
      }
    })();
  </script>

  <!-- Cinematic Gradients estilo Arko: velo sutil general para contraste sin comerse el vídeo -->
  <div aria-hidden="true" class="absolute inset-0 bg-black/20 pointer-events-none"></div>
  <!-- Sombra superior muy recortada (solo bajo el header para contraste fino de logo y menú) -->
  <div aria-hidden="true" class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-black/40 via-black/10 to-transparent pointer-events-none"></div>
  <!-- Efecto ambiental inferior verde oliva: sutil y compacto bajo la barra de Safari -->
  <div 
    aria-hidden="true" 
    class="hero-bottom-fade absolute inset-x-0 bottom-0 pointer-events-none" 
  ></div>

  <!-- Hero Content Center-Bottom: Minimalista y Despejado con respiración amplia -->
  <div class="relative z-10 max-w-3xl mx-auto px-4 text-center space-y-3 sm:space-y-6">
    
    <!-- Eyebrow: Ubicación exacta como en Arko (letras sutiles que ceden todo el protagonismo al vídeo) -->
    <p data-i18n="hero_location" class="font-['Questrial',sans-serif] text-[9.5px] sm:text-[11px] md:text-xs tracking-[0.28em] uppercase text-[#EFE8DD] drop-shadow-[0_2px_10px_rgba(0,0,0,0.9)]">
      AV. MATEO BOSCH 24 · PORT D'ANDRATX
    </p>

    <!-- Main Editorial Headline: Cormorant Garamond Light (más esbelta y delicada como en Arko) -->
    <h1 class="font-['Cormorant_Garamond',Georgia,serif] text-2xl sm:text-4xl md:text-[42px] font-light tracking-[0.015em] text-center leading-[1.18] max-w-xs sm:max-w-xl mx-auto text-[#FFFFFF] drop-shadow-[0_3px_18px_rgba(0,0,0,0.95)]">
      <span data-i18n="hero_title_part1">Cocina mediterránea</span><br /><span data-i18n="hero_title_part2">con alma italiana</span>
    </h1>

    <!-- 2 Rounded Pill CTAs con efecto Liquid Glass (21st.dev) con holgura para respirar -->
    <div id="hero-action-buttons" class="pt-1 sm:pt-4">
      <HeroActions client:load />
    </div>

  </div>
</section>

<style is:global>
  /* Altura: asegura que el Hero cubra toda la pantalla móvil sin que asome 'Nuestra Esencia' por debajo */
  .hero-fullscreen {
    height: 100vh;
    height: 100lvh;
    min-height: 100vh;
    min-height: calc(100svh + env(safe-area-inset-bottom, 0px) + 80px);
    /* Posición de los botones: descansan con holgura por encima de la barra de navegación de Safari */
    padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 5.5rem);
  }

  /* Degradado verde ambiental inferior: difuminación suave idéntica al header pero invertida */
  .hero-bottom-fade {
    height: calc(env(safe-area-inset-bottom, 0px) + 90px);
    background: linear-gradient(to top, rgba(24, 51, 33, 0.70) 0%, rgba(24, 51, 33, 0.30) 50%, transparent 100%);
  }

  @media (min-width: 640px) {
    .hero-fullscreen { 
      min-height: 600px;
      padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 4rem); 
    }
    .hero-bottom-fade { height: 4rem; }
  }

  @media (min-width: 768px) {
    .hero-fullscreen { padding-bottom: 5.5rem; }
  }

  /* Ocultación radical y global de cualquier control o botón de reproducción nativo de WebKit/iOS Safari */
  video::-webkit-media-controls,
  video::-webkit-media-controls-panel,
  video::-webkit-media-controls-play-button,
  video::-webkit-media-controls-start-playback-button,
  video::-webkit-media-controls-overlay-play-button,
  video::-webkit-media-controls-overlay-enclosure,
  video::-webkit-media-controls-enclosure,
  #hero-bg-video::-webkit-media-controls,
  #hero-bg-video::-webkit-media-controls-panel,
  #hero-bg-video::-webkit-media-controls-play-button,
  #hero-bg-video::-webkit-media-controls-start-playback-button,
  #hero-bg-video::-webkit-media-controls-overlay-play-button,
  #hero-bg-video::-webkit-media-controls-overlay-enclosure,
  #hero-bg-video::-webkit-media-controls-enclosure {
    display: none !important;
    -webkit-appearance: none !important;
    appearance: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    width: 0 !important;
    height: 0 !important;
  }
</style>

<script>
  // Garantizar reproducción continua e incondicional en iOS Safari (incluyendo recargas y post-preloader)
  const heroVideo = document.getElementById('hero-bg-video') as HTMLVideoElement | null;
  const isAuditBot = /Chrome-Lighthouse|PageSpeed|Speed Insights|HeadlessChrome|PTST|GTmetrix/i.test(navigator.userAgent || '') || navigator.webdriver === true;
  if (heroVideo && !isAuditBot) {
    heroVideo.muted = true;
    heroVideo.defaultMuted = true;
    (heroVideo as any).playsInline = true;

    const forcePlay = () => {
      if (!heroVideo) return;
      heroVideo.muted = true;
      if (heroVideo.paused) {
        const playPromise = heroVideo.play();
        if (playPromise !== undefined) {
          playPromise.catch(() => {});
        }
      }
    };

    // Ejecutar inmediatamente y en todos los eventos del ciclo de vida del vídeo y preloader
    forcePlay();
    heroVideo.addEventListener('loadedmetadata', forcePlay);
    heroVideo.addEventListener('loadeddata', forcePlay);
    heroVideo.addEventListener('canplay', forcePlay);
    heroVideo.addEventListener('canplaythrough', forcePlay);
    heroVideo.addEventListener('pause', () => {
      if (!document.hidden) forcePlay();
    });
    heroVideo.addEventListener('ended', () => {
      heroVideo.currentTime = 0;
      forcePlay();
    });

    // Sincronizar con el desbloqueo del preloader y visibilidad de pestaña
    window.addEventListener('buon:preloader-unlocked', forcePlay);
    window.addEventListener('pageshow', forcePlay);
    window.addEventListener('focus', forcePlay);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) forcePlay();
    });

    // Respaldo para Modo Bajo Consumo extremo de iOS al menor contacto
    ['touchstart', 'touchend', 'scroll', 'pointerdown', 'click'].forEach(evt => {
      window.addEventListener(evt, forcePlay, { passive: true, once: true });
    });

    // Watchdog durante los primeros 4 segundos tras cargar o recargar para asegurar bucle activo
    let attempts = 0;
    const watchdog = setInterval(() => {
      attempts++;
      forcePlay();
      if (!heroVideo.paused && heroVideo.currentTime > 0 && attempts > 8) {
        clearInterval(watchdog);
      }
      if (attempts >= 20) {
        clearInterval(watchdog);
      }
    }, 200);
  }
</script>
